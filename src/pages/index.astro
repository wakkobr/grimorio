---
import '../styles/global.css';

const categories = [
  { name: 'Sistemas & RPG', id: 'sistemas', active: true },
  { name: 'VTT & Mesas', id: 'vtt', active: false },
  { name: 'Geradores & Tabelas', id: 'geradores', active: false },
  { name: 'Mapas & Cartografia', id: 'mapas', active: false },
  { name: 'Fichas & Ferramentas', id: 'ferramentas', active: false },
];

const cards = [
  {
    title: 'D&D 5e SRD',
    category: 'Sistemas & RPG',
    tag: 'Regras',
    desc: 'Compêndio oficial aberto das regras básicas, magias, monstros e classes.',
    link: 'https://5thsrd.org',
    rune: 'ᚠ',
  },
  {
    title: 'Owlbear Rodeo',
    category: 'VTT & Mesas',
    tag: 'Mesa Virtual',
    desc: 'VTT leve, sem necessidade de instalação, ideal para combates ágeis e mapas táticos.',
    link: 'https://www.owlbear.rodeo',
    rune: 'ᚢ',
  },
  {
    title: 'Kobold Fight Club',
    category: 'Geradores & Tabelas',
    tag: 'Combate',
    desc: 'Calculadora e balanceador de encontros por ND, XP e quantidade de jogadores.',
    link: 'https://koboldplus.club',
    rune: 'ᚦ',
  },
  {
    title: 'Medieval Fantasy City',
    category: 'Mapas & Cartografia',
    tag: 'Gerador',
    desc: 'Gerador procedural de cidades e vilarejos medievais criado por Watabou.',
    link: 'https://watabou.itch.io/medieval-fantasy-city-generator',
    rune: 'ᚨ',
  },
  {
    title: 'Donjon RPG',
    category: 'Geradores & Tabelas',
    tag: 'Utilitários',
    desc: 'Conjunto completo de geradores de masmorras, saques, calendários e NPCs.',
    link: 'https://donjon.bin.sh',
    rune: 'ᚱ',
  },
  {
    title: 'Roll20 VTT',
    category: 'VTT & Mesas',
    tag: 'Mesa Virtual',
    desc: 'Plataforma completa para fichas integradas, mapas dinâmicos e rolagem de dados.',
    link: 'https://roll20.net',
    rune: 'ᚲ',
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grimório Arcana</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=MedievalSharp&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[var(--color-tome-darkLeather)] text-[var(--color-tome-ink)] font-[family-name:var(--font-body)] p-2 sm:p-6 lg:p-10 flex justify-center items-start selection:bg-[var(--color-tome-gold)] selection:text-white">

    <div class="relative w-full max-w-7xl flex flex-col md:flex-row bg-[var(--color-parchment)] border-[6px] sm:border-[10px] border-[var(--color-tome-leather)] rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.8),inset_0_0_80px_rgba(74,44,29,0.25)] overflow-hidden">
      
      <!-- Fita / Encadernação Lateral Esquerda (Decorativa) -->
      <div class="hidden lg:flex flex-col justify-around items-center w-10 bg-[var(--color-tome-leather)] border-r-2 border-[var(--color-tome-gold)] py-8 shadow-inner select-none">
        <div class="w-6 h-12 rounded-sm bg-gradient-to-r from-yellow-700 via-[var(--color-tome-gold)] to-yellow-800 border border-yellow-950/60 shadow"></div>
        <div class="w-6 h-12 rounded-sm bg-gradient-to-r from-yellow-700 via-[var(--color-tome-gold)] to-yellow-800 border border-yellow-950/60 shadow"></div>
        <div class="w-6 h-12 rounded-sm bg-gradient-to-r from-yellow-700 via-[var(--color-tome-gold)] to-yellow-800 border border-yellow-950/60 shadow"></div>
      </div>

      <!-- Sumário Lateral -->
      <aside class="w-full md:w-64 lg:w-72 border-b-2 md:border-b-0 md:border-r-2 border-[var(--color-parchment-aged)] p-6 bg-[var(--color-parchment-light)]/40 flex flex-col justify-between">
        <div>
          <h2 class="font-[family-name:var(--font-title)] text-xl sm:text-2xl text-[var(--color-tome-accent)] tracking-wider border-b border-[var(--color-tome-gold)]/60 pb-2 mb-6">
            Sumário
          </h2>
          <nav class="space-y-3 font-[family-name:var(--font-medieval)] text-lg">
            {categories.map((cat) => (
              <a
                href={`#${cat.id}`}
                class="group flex items-center gap-2 px-3 py-1.5 rounded transition-all duration-200 text-[var(--color-tome-leather)] hover:text-[var(--color-tome-accent)] hover:bg-[var(--color-parchment-dark)]/50"
              >
                <span class="text-[var(--color-tome-gold)] opacity-70 group-hover:opacity-100 transition-opacity">❖</span>
                <span>{cat.name}</span>
              </a>
            ))}
          </nav>
        </div>

        <div class="mt-8 pt-6 border-t border-[var(--color-parchment-aged)] text-center">
          <p class="font-[family-name:var(--font-medieval)] text-xs text-[var(--color-tome-leather)]/70">
            ᛟ Compêndio Livre de RPG ᛟ
          </p>
        </div>
      </aside>

      <!-- Folha Central / Grimório -->
      <main class="flex-1 p-6 sm:p-10 flex flex-col bg-[var(--color-parchment)] relative">
        
        <!-- Faixa Rúnica Superior -->
        <div class="w-full text-center tracking-[0.4em] text-xs sm:text-sm text-[var(--color-tome-gold)] font-bold select-none mb-6 opacity-75">
          ᚛ ᚱᛗᚲ ᚷᚱᛁᛗᛟᚱᛁᛟ ᚪᚱᚳᚪᚾᚪ ᛞᛟ ᛗᛖᛋᛏᚱᛖ ᚜
        </div>

        <!-- Cabeçalho Principal com Capitular Iluminada -->
        <header class="flex items-start gap-4 sm:gap-6 mb-8 border-b-2 border-double border-[var(--color-tome-gold)] pb-6">
          <div class="shrink-0 w-16 h-16 sm:w-20 sm:h-20 bg-[var(--color-tome-accent)] border-2 border-[var(--color-tome-gold)] rounded flex items-center justify-center shadow-md">
            <span class="font-[family-name:var(--font-title)] text-4xl sm:text-5xl text-[var(--color-parchment-light)] select-none">
              G
            </span>
          </div>
          <div>
            <h1 class="font-[family-name:var(--font-title)] text-2xl sm:text-4xl text-[var(--color-tome-ink)] font-bold leading-tight">
              Grimório
            </h1>
            <p class="text-sm sm:text-base text-[var(--color-tome-leather)] leading-relaxed mt-1 max-w-2xl font-[family-name:var(--font-body)]">
              Tomo dedicado à catalogação de ferramentas, referências arcanas, mesas virtuais e geradores para condução de crônicas e campanhas de RPG.
            </p>
          </div>
        </header>

        <!-- Seção de Cards -->
        <section>
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-[family-name:var(--font-medieval)] text-xl text-[var(--color-tome-accent)]">
              Encantamentos & Recursos
            </h3>
            <span class="text-xs uppercase tracking-widest text-[var(--color-tome-leather)]/60 font-semibold">
              {cards.length} Registros
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {cards.map((card) => (
              <a
                href={card.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative bg-[var(--color-parchment-light)] border-2 border-[var(--color-tome-gold)]/70 hover:border-[var(--color-tome-accent)] rounded p-5 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(43,33,24,0.25)]"
              >
                <!-- Cantoneiras Decorativas Sutis -->
                <div class="absolute top-1 left-1 text-[8px] text-[var(--color-tome-gold)] select-none leading-none">╔</div>
                <div class="absolute top-1 right-1 text-[8px] text-[var(--color-tome-gold)] select-none leading-none">╗</div>
                <div class="absolute bottom-1 left-1 text-[8px] text-[var(--color-tome-gold)] select-none leading-none">╚</div>
                <div class="absolute bottom-1 right-1 text-[8px] text-[var(--color-tome-gold)] select-none leading-none">╝</div>

                <div>
                  <div class="flex items-center justify-between border-b border-[var(--color-parchment-aged)] pb-2 mb-3">
                    <span class="text-lg font-bold text-[var(--color-tome-gold)]">{card.rune}</span>
                    <span class="text-xs font-[family-name:var(--font-medieval)] text-[var(--color-tome-leather)] bg-[var(--color-parchment-dark)]/60 px-2 py-0.5 rounded">
                      {card.tag}
                    </span>
                  </div>
                  <h4 class="font-[family-name:var(--font-medieval)] text-lg font-bold text-[var(--color-tome-ink)] group-hover:text-[var(--color-tome-accent)] transition-colors mb-2">
                    {card.title}
                  </h4>
                  <p class="text-sm text-[var(--color-tome-leather)] leading-snug line-clamp-3">
                    {card.desc}
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t border-[var(--color-parchment-aged)]/60 flex items-center justify-between text-xs font-[family-name:var(--font-medieval)] text-[var(--color-tome-accent)]">
                  <span>Consultar</span>
                  <span class="transition-transform group-hover:translate-x-1">➔</span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <!-- Faixa Rúnica Inferior -->
        <div class="w-full text-center tracking-[0.4em] text-xs sm:text-sm text-[var(--color-tome-gold)] font-bold select-none mt-12 opacity-75">
          ᚛ ᚠᛖᛁᛏᛟ ᛈᛟᚱ ᛗᛖᛋᛏᚱᛖᛋ ᛈᚪᚱᚪ ᛗᛖᛋᛏᚱᛖᛋ ᚜
        </div>

      </main>
    </div>

  </body>
</html>