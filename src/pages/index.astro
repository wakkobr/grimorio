---
import '../styles/global.css';
import cardsData from '../data/links.json';

const categories = [
  { name: 'Todos os Tomos', id: 'todos' },
  { name: 'Sistemas & RPG', id: 'sistemas' },
  { name: 'VTT & Mesas', id: 'vtt' },
  { name: 'Geradores & Tabelas', id: 'geradores' },
  { name: 'Mapas & Cartografia', id: 'mapas' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grimório Arcana</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=MedievalSharp&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-tome-darkLeather text-tome-ink font-body p-2 sm:p-6 lg:p-10 flex justify-center items-start selection:bg-tome-gold selection:text-white">

    <div class="relative w-full max-w-7xl flex flex-col md:flex-row bg-parchment border-[6px] sm:border-10 border-tome-leather rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.8),inset_0_0_80px_rgba(74,44,29,0.25)] overflow-hidden">
      
      <!-- Fita / Lombada de Couro -->
      <div class="hidden lg:flex flex-col justify-around items-center w-10 bg-tome-leather border-r-2 border-tome-gold py-8 shadow-inner select-none">
        <div class="w-6 h-12 rounded-sm bg-linear-to-r from-yellow-700 via-tome-gold to-yellow-800 border border-yellow-950/60 shadow"></div>
        <div class="w-6 h-12 rounded-sm bg-linear-to-r from-yellow-700 via-tome-gold to-yellow-800 border border-yellow-950/60 shadow"></div>
        <div class="w-6 h-12 rounded-sm bg-linear-to-r from-yellow-700 via-tome-gold to-yellow-800 border border-yellow-950/60 shadow"></div>
      </div>

      <!-- Sumário Lateral com Filtro Interativo -->
      <aside class="w-full md:w-64 lg:w-72 border-b-2 md:border-b-0 md:border-r-2 border-parchment-aged p-6 bg-parchment-light/40 flex flex-col justify-between">
        <div>
          <h2 class="font-title text-xl sm:text-2xl text-tome-accent tracking-wider border-b border-tome-gold/60 pb-2 mb-6">
            Sumário
          </h2>
          <nav class="space-y-2 font-medieval text-lg" id="category-nav">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-category-btn={cat.id}
                class={`category-filter-btn w-full text-left group flex items-center gap-2 px-3 py-1.5 rounded transition-all duration-200 cursor-pointer ${
                  idx === 0
                    ? 'bg-parchment-dark/70 text-tome-accent font-bold shadow-xs'
                    : 'text-tome-leather hover:text-tome-accent hover:bg-parchment-dark/40'
                }`}
              >
                <span class="rune-bullet text-tome-gold transition-opacity">❖</span>
                <span>{cat.name}</span>
              </button>
            ))}
          </nav>
        </div>

        <div class="mt-8 pt-6 border-t border-parchment-aged text-center">
          <p class="font-medieval text-xs text-tome-leather/70">
            ᛟ Compêndio Livre de RPG ᛟ
          </p>
        </div>
      </aside>

      <!-- Folha Central / Grimório -->
      <main class="flex-1 p-6 sm:p-10 flex flex-col bg-parchment relative">
        
        <!-- Faixa Rúnica Superior -->
        <div class="w-full text-center tracking-[0.4em] text-xs sm:text-sm text-tome-gold font-bold select-none mb-6 opacity-75">
          ᚛ ᚱᛗᚲ ᚷᚱᛁᛗᛟᚱᛁᛟ ᚪᚱᚳᚪᚾᚪ ᛞᛟ ᛗᛖᛋᛏᚱᛖ ᚜
        </div>

        <!-- Cabeçalho Principal -->
        <header class="flex items-start gap-4 sm:gap-6 mb-8 border-b-2 border-double border-tome-gold pb-6">
          <div class="shrink-0 w-16 h-16 sm:w-20 sm:h-20 bg-tome-accent border-2 border-tome-gold rounded flex items-center justify-center shadow-md">
            <span class="font-title text-4xl sm:text-5xl text-parchment-light select-none">
              G
            </span>
          </div>
          <div class="flex-1">
            <h1 class="font-title text-2xl sm:text-4xl text-tome-ink font-bold leading-tight">
              Grimório
            </h1>
            <p class="text-sm sm:text-base text-tome-leather leading-relaxed mt-1 max-w-2xl font-body">
              Tomo dedicado à catalogação de ferramentas, referências arcanas, mesas virtuais e geradores para condução de crônicas e campanhas de RPG.
            </p>
          </div>
        </header>

        <!-- Barra de Busca Rápida -->
        <div class="mb-6 relative">
          <input
            type="text"
            id="search-input"
            placeholder="Buscar encanto, sistema ou ferramenta..."
            class="w-full px-4 py-2.5 bg-parchment-light/80 border-2 border-parchment-aged focus:border-tome-gold rounded text-tome-ink placeholder-tome-leather/50 font-body text-base outline-none transition-colors shadow-inner"
          />
          <span class="absolute right-3.5 top-2.5 text-tome-gold select-none">ᛋ</span>
        </div>

        <!-- Seção de Cards -->
        <section>
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-medieval text-xl text-tome-accent" id="section-title">
              Todos os Tomos
            </h3>
            <span class="text-xs uppercase tracking-widest text-tome-leather/60 font-semibold" id="card-counter">
              {cardsData.length} Registros
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="cards-container">
            {cardsData.map((card) => (
              <a
                href={card.link}
                target="_blank"
                rel="noopener noreferrer"
                data-card-item
                data-card-category={card.category}
                data-card-title={card.title.toLowerCase()}
                data-card-desc={card.desc.toLowerCase()}
                data-card-tag={card.tag.toLowerCase()}
                class="group relative bg-parchment-light border-2 border-tome-gold/70 hover:border-tome-accent rounded p-5 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(43,33,24,0.25)]"
              >
                <!-- Cantoneiras Decorativas Sutis -->
                <div class="absolute top-1 left-1 text-[8px] text-tome-gold select-none leading-none">╔</div>
                <div class="absolute top-1 right-1 text-[8px] text-tome-gold select-none leading-none">╗</div>
                <div class="absolute bottom-1 left-1 text-[8px] text-tome-gold select-none leading-none">╚</div>
                <div class="absolute bottom-1 right-1 text-[8px] text-tome-gold select-none leading-none">╝</div>

                <div>
                  <div class="flex items-center justify-between border-b border-parchment-aged pb-2 mb-3">
                    <span class="text-lg font-bold text-tome-gold">{card.rune}</span>
                    <span class="text-xs font-medieval text-tome-leather bg-parchment-dark/60 px-2 py-0.5 rounded">
                      {card.tag}
                    </span>
                  </div>
                  <h4 class="font-medieval text-lg font-bold text-tome-ink group-hover:text-tome-accent transition-colors mb-2">
                    {card.title}
                  </h4>
                  <p class="text-sm text-tome-leather leading-snug line-clamp-3">
                    {card.desc}
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t border-parchment-aged/60 flex items-center justify-between text-xs font-medieval text-tome-accent">
                  <span>Consultar</span>
                  <span class="transition-transform group-hover:translate-x-1">➔</span>
                </div>
              </a>
            ))}
          </div>

          <div id="no-results" class="hidden text-center py-12 border border-dashed border-parchment-aged rounded mt-4">
            <p class="font-medieval text-lg text-tome-leather">
              Nenhum encantamento encontrado com estes termos.
            </p>
          </div>
        </section>

        <!-- Faixa Rúnica Inferior -->
        <div class="w-full text-center tracking-[0.4em] text-xs sm:text-sm text-tome-gold font-bold select-none mt-12 opacity-75">
          ᚛ ᚠᛖᛁᛏᛟ ᛈᛟᚱ ᛗᛖᛋᛏᚱᛖᛋ ᛈᚪᚱᚪ ᛗᛖᛋᛏᚱᛖᛋ ᚜
        </div>

      </main>
    </div>

    <script>
      let activeCategory = 'todos';
      let searchQuery = '';

      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-category-btn]');
      const cards = document.querySelectorAll<HTMLElement>('[data-card-item]');
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const counter = document.getElementById('card-counter');
      const noResults = document.getElementById('no-results');
      const sectionTitle = document.getElementById('section-title');

      function filterCards() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const category = card.getAttribute('data-card-category') || '';
          const title = card.getAttribute('data-card-title') || '';
          const desc = card.getAttribute('data-card-desc') || '';
          const tag = card.getAttribute('data-card-tag') || '';

          const matchCategory = activeCategory === 'todos' || category === activeCategory;
          const matchSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery) || tag.includes(searchQuery);

          if (matchCategory && matchSearch) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (counter) {
          counter.textContent = `${visibleCount} Registros`;
        }

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetCategory = btn.getAttribute('data-category-btn') || 'todos';
          activeCategory = targetCategory;

          buttons.forEach((b) => {
            b.classList.remove('bg-parchment-dark/70', 'text-tome-accent', 'font-bold', 'shadow-xs');
            b.classList.add('text-tome-leather');
          });

          btn.classList.add('bg-parchment-dark/70', 'text-tome-accent', 'font-bold', 'shadow-xs');
          btn.classList.remove('text-tome-leather');

          if (sectionTitle) {
            sectionTitle.textContent = btn.querySelector('span:last-child')?.textContent || 'Registros';
          }

          filterCards();
        });
      });

      searchInput?.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        filterCards();
      });
    </script>
  </body>
</html>